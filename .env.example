# KrishiLens Environment Configuration

# Hugging Face User Access Token (Required for router.huggingface.co)
HF_TOKEN=hf_your_token_here

# Server Port
PORT=3001

# Gemma 4 / Vision Model Identifier
# Provider routing via Hugging Face Router
VISION_MODEL=google/gemma-4-31B-it:novita
FALLBACK_VISION_MODEL=google/gemma-3-27b-it
